{
  "name": "severus-by-anfal",
  "version": "1.0.0",
  "private": true,
  "description": "SeverusByAnfal — online store (phone/OTP auth, admin dashboard, Mada/Apple Pay/Visa/Mastercard checkout, Arabic/English).",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/db/migrations.sql','dist/db/migrations.sql')\"",
    "start": "NODE_NO_WARNINGS=1 node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0"
  }
}
