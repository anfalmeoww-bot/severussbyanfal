# ── Copy this file to .env and fill in real values before deploying. ──
# Never commit your real .env file.

# --- Core ---
NODE_ENV=production
PORT=3000
# Public base URL of your deployed site (no trailing slash)
BASE_URL=https://your-domain.com
# Long random string used to sign session tokens & CSRF tokens & OTP hashes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=replace-this-with-a-long-random-secret

# --- Store owner / admin access ---
# Comma-separated list of phone numbers (E.164 format, e.g. +9665XXXXXXXX)
# that are always granted admin/store-management access when they log in.
ADMIN_PHONE_NUMBERS=+9665XXXXXXXX

# --- Database ---
# Path to the SQLite database file (created automatically on first run).
DATABASE_FILE=./data/store.db

# --- SMS / OTP provider ---
# One of: console | unifonic
# "console" just prints the OTP code to the server log — useful for local
# testing only. Use "unifonic" (or wire up another provider, see src/sms)
# in production.
SMS_PROVIDER=console
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=SeverusByAnfal

# --- Payments provider ---
# One of: mock | moyasar
# "mock" lets you click a "Simulate successful payment" button — useful for
# local testing only, never enable it in production.
PAYMENT_PROVIDER=mock
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
DEFAULT_CURRENCY=SAR

# --- Apple Pay domain verification (only needed once you enable Apple Pay) ---
# Paste the exact contents of the file Moyasar/Apple gives you here; it will
# be served at /.well-known/apple-developer-merchantid-domain-association
APPLE_PAY_DOMAIN_ASSOCIATION=
