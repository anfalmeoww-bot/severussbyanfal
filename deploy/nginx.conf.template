# Nginx reverse-proxy config for SeverusByAnfal.
# __DOMAIN__ is replaced automatically by deploy/setup-server.sh.
# (Certbot will add the HTTPS server block and redirect automatically
# when you run `certbot --nginx` — this file just needs the plain-HTTP
# block to exist first so Certbot has something to attach to.)

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Lets Certbot's HTTP-01 challenge succeed.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Product image uploads can be a few MB.
        client_max_body_size 8m;
    }
}
